<launch>
  <arg name="ur_type" default="ur5"/>
  <!-- forward_velocity_controller: cartesian_controller
       forward_effort_controller:   dynamic_controller (computed torque, started below) -->
  <arg name="initial_joint_controller" default="forward_velocity_controller"/>

  <include file="$(find-pkg-share ur_simulation_gz)/launch/ur_sim_control.launch.py">
    <arg name="ur_type" value="$(var ur_type)"/>
    <arg name="description_file" value="$(find-pkg-share barista_gazebo)/urdf/barista_gz.urdf.xacro"/>
    <arg name="controllers_file" value="$(find-pkg-share barista_gazebo)/config/barista_controllers.yaml"/>
    <arg name="world_file" value="$(find-pkg-share barista_gazebo)/worlds/barista_cafe.sdf --gui-config $(find-pkg-share barista_gazebo)/config/gui.config"/>
    <arg name="initial_joint_controller" value="$(var initial_joint_controller)"/>
  </include>

  <!-- Load the ros gazebo bridge -->
  <node pkg="ros_gz_bridge" exec="parameter_bridge" name="barista_bridge" output="screen">
    <param name="config_file" value="$(find-pkg-share barista_gazebo)/config/bridge.yaml"/>
  </node>

  <!-- Sensors: wrist F/T, scale, overhead RGB-D camera -->
  <node pkg="ros_gz_bridge" exec="parameter_bridge" name="sensors_bridge" output="screen">
    <param name="config_file" value="$(find-pkg-share barista_gazebo)/config/sensors_bridge.yaml"/>
  </node>
  <!-- optical frame of models/overhead_camera at world (-0.6, 0, 2.0), looking down -->
  <node pkg="tf2_ros" exec="static_transform_publisher" name="camera_tf"
        args="--x -0.6 --y 0 --z 2.0 --qx 0.70710678 --qy -0.70710678 --qz 0 --qw 0
              --frame-id world --child-frame-id camera_optical_frame"/>

  <node pkg="barista_control" exec="dynamic_controller" output="screen"
        if="$(eval '\'$(var initial_joint_controller)\' == \'forward_effort_controller\'')">
    <param name="use_sim_time" value="true"/>
    <param name="go_home_duration" value="3.0"/>
  </node>
</launch>
