<launch>
  <arg name="ur_type" default="ur5"/>
  <!-- handles running with static controller or dynamic controller-->
  <arg name="dynamic" default="false"/>

  <include file="$(find-pkg-share ur_simulation_gz)/launch/ur_sim_control.launch.py">
    <arg name="ur_type" value="$(var ur_type)"/>
    <arg name="description_file" value="$(find-pkg-share barista_gazebo)/urdf/barista_gz.urdf.xacro"/>
    <arg name="controllers_file" value="$(find-pkg-share barista_gazebo)/config/barista_controllers.yaml"/>
    <arg name="world_file" value="$(find-pkg-share barista_gazebo)/worlds/barista_cafe.sdf --gui-config $(find-pkg-share barista_gazebo)/config/gui.config"/>
  
    <arg name="initial_joint_controller" value="forward_velocity_controller"/>
  </include>

  <!-- Load the ros gazebo bridge -->
  <node pkg="ros_gz_bridge" exec="parameter_bridge" name="barista_bridge" output="screen">
    <param name="config_file" value="$(find-pkg-share barista_gazebo)/config/bridge.yaml"/>
  </node>

  <!-- Sensors: wrist F/T, scale, overhead RGB-D camera -->
  <node pkg="ros_gz_bridge" exec="parameter_bridge" name="sensors_bridge" output="screen">
    <param name="config_file" value="$(find-pkg-share barista_gazebo)/config/sensors_bridge.yaml"/>
  </node>
  <!-- optical frame of models/overhead_camera at world (-0.6, 0, 2.0), looking down -->
  <node pkg="tf2_ros" exec="static_transform_publisher" name="camera_tf"
        args="--x -0.6 --y 0 --z 2.0 --qx 0.70710678 --qy -0.70710678 --qz 0 --qw 0 --frame-id world --child-frame-id camera_optical_frame"/>


  <!-- Detach quick fix. TODO: move into state machine INIT -->
  <!-- DetachableJoint loads with the robot spawn, so repeat until just before -->
  <executable cmd="ros2 topic pub -r 2 -t 60 /cup/detach std_msgs/msg/Empty" output="log"/>
  <executable cmd="ros2 topic pub -r 2 -t 60 /pitcher/detach std_msgs/msg/Empty" output="log"/>

  <group if="$(var dynamic)">
    <!-- load the effort controller inactive velocity controller holds the arm -->
    <node pkg="controller_manager" exec="spawner"
          args="forward_effort_controller -c /controller_manager --inactive"/>

    <!-- start in hold mode before the switch so its already publishing -->
    <timer period="20.0">
      <node pkg="barista_control" exec="dynamic_controller" output="screen">
        <param name="use_sim_time" value="true"/>
        <param name="go_home_duration" value="0.0"/>
        <param name="control_rate" value="200.0"/>
      </node>
    </timer>

    <!-- hand over velocity to effort once the robot is spawned and detached -->
    <timer period="25.0">
      <executable cmd="ros2 control switch_controllers --deactivate forward_velocity_controller --activate forward_effort_controller"
                  output="screen"/>
    </timer>
  </group>


</launch>