<?xml version="1.0"?>
<sdf version="1.11">
  <model name="pitcher">
    <link name="link">
      <inertial auto="true"/>

      <collision name="collision">
        <density>1300</density>
        <geometry>
          <mesh optimization="convex_decomposition">
            <uri>model://pitcher/rbe501_pitcher.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <visual name="visual">
        <material>
          <ambient>0.7 0.7 0.75</ambient>
          <diffuse>0.7 0.7 0.75</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
        </material>

        <geometry>
          <mesh>
          <uri>model://pitcher/rbe501_pitcher.stl</uri></mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
