<?xml version="1.0"?>
<sdf version="1.11">
  <model name="pitcher">
    <!--Publishes the model pose for controller use later-->
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>30</update_frequency>
    </plugin>
    
    <link name="link">
      <inertial auto="true"/>

      <collision name="collision">
        <density>1300</density>
        <geometry>
          <mesh optimization="convex_decomposition">
            <uri>model://pitcher/rbe501_pitcher.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <visual name="visual">
        <material>
          <ambient>0.7 0.7 0.75</ambient>
          <diffuse>0.7 0.7 0.75</diffuse>
          <specular>0.8 0.8 0.8 1</specular>
        </material>

        <geometry>
          <mesh>
          <uri>model://pitcher/rbe501_pitcher.stl</uri></mesh>
        </geometry>
      </visual>
    </link>
  </model>
</sdf>
