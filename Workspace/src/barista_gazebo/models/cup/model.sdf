<?xml version="1.0"?>
<sdf version="1.11">
  <model name="cup">
    <link name="link">
      <inertial auto="true"/>

      <collision name="collision">
        <density>2400</density>
        <geometry>
          <mesh optimization="convex_decomposition">
            <uri>model://cup/cup.stl</uri>
          </mesh>
        </geometry>
      </collision>

      <visual name="visual">
        <geometry>
          <mesh>
            <uri>model://cup/cup.stl</uri>
          </mesh>
        </geometry>
      </visual>
    </link>
    
  </model>
</sdf>
