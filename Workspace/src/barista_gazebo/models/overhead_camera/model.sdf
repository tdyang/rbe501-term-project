<?xml version="1.0"?>
<sdf version="1.11">
  <!-- RGB-D camera looking straight down (camera +x -> world -z, image up -> world +x).
       Publishes /camera/{image,depth_image,points,camera_info} in frame camera_optical_frame. -->
  <model name="overhead_camera">
    <static>true</static>
    <link name="link">
      <pose>0 0 0 0 1.5707963 0</pose>
      <visual name="visual">
        <geometry><box><size>0.03 0.1 0.03</size></box></geometry>
      </visual>
      <sensor name="rgbd" type="rgbd_camera">
        <always_on>true</always_on>
        <update_rate>15</update_rate>
        <topic>/camera</topic>
        <gz_frame_id>camera_optical_frame</gz_frame_id>
        <camera>
          <horizontal_fov>1.2</horizontal_fov>
          <image><width>640</width><height>480</height></image>
          <clip><near>0.1</near><far>5.0</far></clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
